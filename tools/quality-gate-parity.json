      "localStep": "Validate migrations"
    },
    {
      "hostedStep": "Validate version-controlled OpenAPI contract",
      "localStep": "Validate version-controlled OpenAPI contract"
    },
    {
      "hostedStep": "Validate recovery drill safety contract",
