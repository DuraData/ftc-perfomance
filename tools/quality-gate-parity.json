    },
    {
      "hostedStep": "Type-check frontend",
      "localStep": "Type-check frontend"
    },
    {
      "hostedStep": "Lint frontend",
      "localStep": "Lint frontend"
    },
    {
      "hostedStep": "Test frontend",
      "localStep": "Test frontend"
    },
    {
      "hostedStep": "Test accessibility baseline",
      "localStep": "Test accessibility baseline"
    },
    {
      "hostedStep": "Build frontend and enforce bundle budget",
