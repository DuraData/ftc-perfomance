# Configure these through the deployment secret provider; never commit real values.
ConnectionStrings__DefaultConnection=
Database__Provider=SqlServer
Database__EnsureCreated=false
# Disposable local SQLite alternative (leave production on SqlServer):
# ConnectionStrings__DefaultConnection=Data Source=OPMS_Development.db
# Database__Provider=Sqlite
# Database__EnsureCreated=true
JwtSettings__Secret=
Security__AllowedOrigins__0=https://opms.example.gov.za
EvidenceScanning__ScanEndpoint=https://scanner.example.gov.za/api/scan
EvidenceScanning__HealthEndpoint=https://scanner.example.gov.za/health
EvidenceScanning__ApiKey=
EvidenceScanning__TimeoutSeconds=30
EvidenceStorage__Provider=Http
EvidenceStorage__Endpoint=https://storage.example.gov.za/api/objects
EvidenceStorage__HealthEndpoint=https://storage.example.gov.za/health
EvidenceStorage__ApiKey=
EvidenceStorage__TimeoutSeconds=30
Notifications__Channels=IN_APP,EMAIL
Notifications__Email__Endpoint=https://notifications.example.gov.za/api/email
Notifications__Email__ApiKey=
Notifications__Email__TimeoutSeconds=20
SeedData__Enabled=false
