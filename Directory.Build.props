<Project>
  <PropertyGroup>
    <!-- Generated evidence and nested tool/test outputs can contain copied projects.
         Excluding them up front prevents recursive SDK item discovery locally. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\**\artifacts\**;$(MSBuildProjectDirectory)\**\bin\**;$(MSBuildProjectDirectory)\**\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
