{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "test.ftcsolutions.co.za",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "EnsureCreated": false
  },
  "JwtSettings": {
    "Secret": "",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "SessionIdleTimeoutMinutes": 30,
    "SessionAbsoluteTimeoutHours": 24,
    "MaxConcurrentSessions": 5,
    "MfaRequiredPermissionCodes": [
      "SECURITY.SYSTEM_SCOPE",
      "SECURITY.MANAGE_ROLES",
      "SECURITY.ASSIGN_ROLES",
      "SECURITY.MANAGE_PERMISSIONS",
      "SECURITY.MANAGE_NAVIGATION"
    ],
    "Issuer": "FTCERP",
    "Audience": "FTCERP"
  },
  "Security": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "PasswordReset": {
      "PublicBaseUrl": "https://test.ftcsolutions.co.za",
      "TokenLifetimeMinutes": 30
    },
    "PasswordProtection": {
      "CompromisedCheckEnabled": true,
      "Endpoint": "https://api.pwnedpasswords.com/range",
      "MinimumBreachCount": 1,
      "FailClosed": true,
      "TimeoutSeconds": 5,
      "CacheMinutes": 60
    }
  },
  "SeedData": {
    "Enabled": false,
    "DemoUsersEnabled": false
  },
  "Outbox": {
    "PollSeconds": 10,
    "DegradedAfterMinutes": 10
  },
  "Observability": {
    "Alerts": {
      "MinimumRequests": 20,
      "FailureRatePercent": 5,
      "AverageDurationMilliseconds": 1500
    }
  },
  "EvidenceDisposal": {
    "PollSeconds": 30
  },
  "EvidenceStorage": {
    "Provider": "Http",
    "LocalRoot": "",
    "Endpoint": "",
    "HealthEndpoint": "",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "Notifications": {
    "Channels": "IN_APP,EMAIL",
    "SchedulerMinutes": 5,
    "Email": {
      "Endpoint": "",
      "ApiKey": "",
      "TimeoutSeconds": 20
    },
    "Sms": {
      "Endpoint": "",
      "ApiKey": "",
      "TimeoutSeconds": 20
    }
  },
  "EvidenceScanning": {
    "ScanEndpoint": "",
    "HealthEndpoint": "",
    "ApiKey": "",
    "TimeoutSeconds": 30
  }
}
