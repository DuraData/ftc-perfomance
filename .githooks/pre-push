#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell_command=powershell.exe
else
    echo "OPMS pre-push gate cannot run because PowerShell is not available." >&2
    exit 1
fi

echo "Running the repository-owned OPMS quality gate before push..."
"$powershell_command" -NoLogo -NoProfile -File "$repository_root/tools/Invoke-LocalQualityGate.ps1"
